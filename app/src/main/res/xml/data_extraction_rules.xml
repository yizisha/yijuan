<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Cloud Backup rules (API 31+).

  Same policy as backup_rules.xml: preferences only, no database.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="device.xml"/>
        <exclude domain="sharedpref" path="book_file_sources.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- A transferred location cannot transfer the provider's persisted URI permission. -->
        <exclude domain="sharedpref" path="book_file_sources.xml"/>
    </device-transfer>
</data-extraction-rules>
